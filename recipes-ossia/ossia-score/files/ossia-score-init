#!/bin/sh
# Minimal PID 1 for appliances that need nothing but score: no systemd, no
# service manager. Boot with init=/usr/bin/ossia-score-init.
#
# This stays PID 1 itself and runs score as a child, rather than exec'ing it.
# Two reasons: the kernel panics if PID 1 exits, so an exec'd score turns any
# crash into a panic; and PID 1 inherits zombie reaping, which score needs
# because it forks VST/VST3/CLAP puppets and Faust processes.
#
# CONFIG_DEVTMPFS_MOUNT gives us /dev already; everything else is on us.
set -u

# The kernel hands PID 1 no PATH, and ip and udhcpc live in /sbin.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin

mount -o remount,rw / 2>/dev/null
mount -t proc     proc     /proc    2>/dev/null
mount -t sysfs    sysfs    /sys     2>/dev/null
mount -t tmpfs    tmpfs    /run     2>/dev/null
mount -t tmpfs    tmpfs    /tmp     2>/dev/null
mkdir -p /dev/pts /dev/shm /run/ossia-score 2>/dev/null
mount -t devpts   devpts   /dev/pts 2>/dev/null
mount -t tmpfs    tmpfs    /dev/shm 2>/dev/null
mount -t tmpfs    tmpfs    /var/volatile 2>/dev/null

# Load these before starting udev: nvidia-drm brings up the display, and
# udev's settle can hold the panel dark for seconds otherwise.
# udev only loads what a device alias points at. Modules listed here have none
# -- nvidia-drm on Tegra is the one that matters, and without it there is no KMS
# device and score dies on a display with no screens.
for conf in /etc/modules-load.d/*.conf; do
  [ -r "$conf" ] || continue
  while read -r mod; do
    case "$mod" in ''|\#*) continue ;; esac
    modprobe "$mod" 2>/dev/null
  done < "$conf"
done

# DRM and input drivers are modules on most boards (CONFIG_DRM=m on Tegra).
# Without udev to autoload them /dev/dri/card0 never appears, ossia-score-launch
# picks the headless backend, and libinput gets no devices.
if [ -x /lib/systemd/systemd-udevd ]; then
  /lib/systemd/systemd-udevd --daemon 2>/dev/null
  udevadm trigger --action=add 2>/dev/null
  udevadm settle --timeout=10 2>/dev/null
fi

# No network manager here, so bring the interfaces up by hand. Loopback matters
# even with no cable: score's remote control and its OSC ports bind to it, and
# the kernel leaves lo down until someone asks. udhcpc backgrounds itself after
# the first attempt, so an unplugged board does not delay the boot.
ip link set lo up 2>/dev/null
# In the background: with no DHCP server answering, udhcpc retries for tens of
# seconds, and score should not wait for it.
(
  for netif in /sys/class/net/*; do
    iface=${netif##*/}
    # Only real hardware: skip lo and the virtual interfaces udev invents.
    [ -e "$netif/device" ] || continue
    ip link set "$iface" up 2>/dev/null
    udhcpc -i "$iface" -b -t 3 -s /usr/share/udhcpc/default.script \
        >/dev/null 2>&1
  done

  # Nothing logs here and there is no way to ask the board its address short of
  # the rescue shell, so announce it on the console once it has one, and leave
  # it in /run for anything that wants to read it.
  waited=0
  while [ $waited -lt 60 ]; do
    addr=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $2"="$4}')
    if [ -n "$addr" ]; then
      echo "ossia-score: address $addr" > /dev/console 2>/dev/null
      echo "$addr" > /run/ossia-score-address 2>/dev/null
      break
    fi
    sleep 1
    waited=$((waited + 1))
  done
) &

# Hold any key during boot to get a shell instead of score. The tty starts in
# canonical mode, where a held key is buffered but unreadable until Enter, so
# switch to raw and read a single byte. "min 0 time 3" returns after 0.3s at
# worst, which is the whole cost of the check on a normal boot. /dev/console is
# the serial line; /dev/tty0 is a keyboard attached to the board.
# read -t cannot outlast its timeout whatever state the terminal is in, and
# read -n puts the terminal in non-canonical mode itself. dd and stty cannot:
# stty is best-effort on the Tegra combined UART, which has partial termios
# support, and a dd that lands on a still-canonical tty blocks PID 1 forever.
held_key() {
  for tty in /dev/console /dev/tty0; do
    [ -c "$tty" ] || continue
    key=""
    read -r -t 1 -n 1 key < "$tty" 2>/dev/null || true
    [ -n "$key" ] && return 0
  done
  return 1
}

if held_key; then
  echo "" > /dev/console 2>/dev/null
  echo "key held: starting a shell. Exit it and score starts." > /dev/console 2>/dev/null
  { [ -x /bin/bash ] && /bin/bash || /bin/sh ; } < /dev/console > /dev/console 2>&1
fi

# ossia-score-launch picks its backend from /dev/dri/card0, so do not race it.
waited=0
while [ ! -e /dev/dri/card0 ] && [ $waited -lt 50 ]; do
  sleep 0.1
  waited=$((waited + 1))
done

# Nothing here reads /etc/profile.d: there is no login shell and no systemd. Qt
# picks eglfs_kms_egldevice on its own on Tegra, which lands on the host1x node
# with no KMS and takes score down with it, so the drop-ins that select a backend
# have to be applied by hand.
set +u
for env in /etc/profile.d/*.sh; do
  [ -r "$env" ] || continue
  . "$env"
done
set -u

export HOME=/root
export XDG_RUNTIME_DIR=/run/ossia-score
export XDG_CACHE_HOME=/tmp/cache
mkdir -p "$XDG_CACHE_HOME" 2>/dev/null
# Qt refuses a runtime dir that is not 0700 and owned by the user, warns, and
# falls back to /tmp.
chmod 0700 "$XDG_RUNTIME_DIR" 2>/dev/null

# There is no getty and no ssh here, so a score that cannot start would leave a
# board recoverable only by reflashing. After three failures in a row that were
# too quick to be a real session, hand the console a shell instead.
quickfails=0
while true; do
  started=$(cut -d' ' -f1 /proc/uptime)
  /usr/bin/ossia-score-launch "$@"
  status=$?
  stopped=$(cut -d' ' -f1 /proc/uptime)

  if [ "${started%.*}" -gt 0 ] && [ $((${stopped%.*} - ${started%.*})) -lt 10 ]; then
    quickfails=$((quickfails + 1))
  else
    quickfails=0
  fi
  echo "ossia-score exited ($status), restarting in 2s" > /dev/console 2>/dev/null

  if [ $quickfails -ge 3 ]; then
    echo "ossia-score failed 3 times; starting a shell, exit it to retry" > /dev/console 2>/dev/null
    quickfails=0
    sh < /dev/console > /dev/console 2>&1
  fi
  sleep 2
done
